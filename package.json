{
  "name": "@ashluc/retouch",
  "version": "0.1.0",
  "description": "Portrait retouch editor \u2014 face-aware geometry, skin, makeup and heal, entirely in the browser.",
  "type": "module",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.7",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
